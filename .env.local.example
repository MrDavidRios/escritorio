VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: override the local dev server port (e.g. when running multiple
# checkouts side by side). Defaults to 5173 if unset.
VITE_DEV_PORT=5174

# Server-side secrets. Never prefix these with VITE_ — Vite would bundle them.
# TypeSafe (Jev) key for the grade-phrase Edge Function (`bun run functions:serve`).
TYPESAFE_API_KEY=your-typesafe-key
# For deploying Edge Functions by hand; CI reads these from GitHub secrets.
SUPABASE_ACCESS_TOKEN=sbp_your-access-token
SUPABASE_PROJECT_REF=your-project-ref
