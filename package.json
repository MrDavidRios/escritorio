{
  "name": "escritorio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @escritorio/web dev",
    "build": "bun run --filter '*' typecheck && bun run --filter @escritorio/web build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "preview": "bun run --filter @escritorio/web preview",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:config": "cp supabase/config.local.toml supabase/config.toml",
    "db:start": "bun run db:config && supabase start",
    "db:stop": "supabase stop",
    "db:reset": "bun run db:config && supabase db reset",
    "db:status": "supabase status"
  },
  "devDependencies": {
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.120.0"
  }
}
